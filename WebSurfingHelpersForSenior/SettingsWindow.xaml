<Window x:Class="WebSurfingHelpersForSenior.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정"
        Width="600" Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="White">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" >
            <TextBlock Text="⚙ 설정 메뉴"
                       FontSize="22"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="🎤 음성 설정"
                        FontSize="18"
                        Width="180" Height="50" Margin="10"
                        Click="ShowVoiceSettings_Click"/>
                <Button Content="🏠 홈 주소 설정"
                        FontSize="18"
                        Width="180" Height="50" Margin="10"
                        Click="SetHomeUrl_Click"/>
            </StackPanel>
            <Button Content="닫기"
                    FontSize="16"
                    Width="120" Height="40" Margin="10"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>