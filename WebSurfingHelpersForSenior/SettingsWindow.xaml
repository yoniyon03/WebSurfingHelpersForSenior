<Window x:Class="WebSurfingHelpersForSenior.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Height="250" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <!-- 상단 설정 메뉴 버튼 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="음성 설정" Width="120" Height="30" Margin="10" Click="ShowVoiceSettings_Click"/>
                <Button Content="홈 주소 설정" Width="120" Height="30" Margin="10" Click="SetHomeUrl_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
