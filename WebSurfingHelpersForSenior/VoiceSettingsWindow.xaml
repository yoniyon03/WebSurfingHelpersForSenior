<Window x:Class="WebSurfingHelpersForSenior.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="음성 설정" Height="250" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="속도 조절 (-10 ~ 10)" FontSize="16" Margin="10,0,0,8"/>
            <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" TickFrequency="1" Value="0"
                    IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <TextBlock Text="볼륨 조절 (0 ~ 100)" FontSize="16" Margin="10,20,0,8"/>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" Value="100"
                    IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
        </StackPanel>
    </Grid>
</Window>
