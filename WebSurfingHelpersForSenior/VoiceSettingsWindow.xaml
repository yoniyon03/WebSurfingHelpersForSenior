<Window x:Class="WebSurfingHelpersForSenior.VoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="음성 설정"
        Width="600" Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <TextBlock Text="📢 음성 속도 조절 (-10 ~ 10)" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>
            <Slider x:Name="RateSlider"
                    Minimum="-10" Maximum="10" TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"
                    Height="40" FontSize="18"/>

            <TextBlock Text="🔊 음성 볼륨 조절 (0 ~ 100)" FontSize="22" FontWeight="Bold" Margin="20,30,0,10" TextAlignment="Center"/>
            <Slider x:Name="VolumeSlider"
                    Minimum="0" Maximum="100" TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"
                    Height="40" FontSize="18"/>
        </StackPanel>
    </Grid>
</Window>
