<Window x:Class="WebSurfingHelpersForSenior.FavoriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebSurfingHelpersForSenior"
        mc:Ignorable="d"
        Title="즐겨찾기" Height="400" Width="500" WindowStartupLocation="CenterOwner">
    
    <Grid Margin="20">
        <StackPanel>
            <Button Content="현재 페이지 즐겨찾기 추가" Click="AddFavorite_Click" Margin="0, 0, 0, 10"/>
            <Button Content="즐겨찾기 목록에서 삭제" Click="RemoveFavorite_Click" Margin="0, 0, 0, 10"/>
            <ListBox x:Name="FavoritesList" Height="200" SelectionChanged="FavoritesList_SelectionChanged"/>
            <Button x:Name="NavigateButton" Content="선택한 사이트 바로가기" Click="NavigateFavorite_Click" Margin="0, 10, 0 0"/>
        </StackPanel>
    </Grid>
</Window>
