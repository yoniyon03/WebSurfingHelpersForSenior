<Window x:Class="WebSurfingHelpersForSenior.FavoriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⭐ 즐겨찾기"
        Width="600" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="30">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">

            <TextBlock Text="📌 즐겨찾기 관리" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>

            <Button Content="➕ 현재 페이지 즐겨찾기 추가"
                    FontSize="18" Height="50" Margin="0,0,0,10"
                    Click="AddFavorite_Click"/>

            <Button Content="➖ 선택한 즐겨찾기 삭제"
                    FontSize="18" Height="50" Margin="0,0,0,10"
                    Click="RemoveFavorite_Click"/>

            <ListBox x:Name="FavoritesList"
                     FontSize="16"
                     Height="200"
                     Margin="0,10,0,10"
                     SelectionChanged="FavoritesList_SelectionChanged"/>

            <Button x:Name="NavigateButton"
                    Content="🌐 선택한 사이트 바로가기"
                    FontSize="18"
                    Height="50"
                    Click="NavigateFavorite_Click"/>
        </StackPanel>
    </Grid>
</Window>