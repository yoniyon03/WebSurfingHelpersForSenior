<Window x:Class="WebSurfingHelpersForSenior.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="MyApp" Height="800" Width="1200" Background="#FFF9F3E8" ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#004578"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#002C4A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- 상단 버튼 바 -->
            <RowDefinition Height="*"/>
            <!-- 메인 텍스트 박스 -->
            <RowDefinition Height="60"/>
            <!-- 하단 도구 바 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- 웹 브라우저 -->
            <ColumnDefinition Width="300"/>
            <!-- 오른쪽 AI 패널 -->
        </Grid.ColumnDefinitions>

        <!-- 상단 버튼 바 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center" >
            <!-- 좌측 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
                <!-- 홈 바로가기 -->
                <Button Style="{StaticResource RoundedButtonStyle}" Width="60" Height="40" Margin="4" ToolTip="홈" Click="HomeButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/7606/7606153.png" />
                        <TextBlock Text="홈" Margin="4 0 0 0" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
                
                <!-- 즐겨찾기 -->
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="90" Height="40" Margin="4" ToolTip="즐겨찾기" Click="FavoritesButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/5187/5187586.png" />
                        <TextBlock Text="즐겨찾기" Margin="4 0 0 0" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 중앙 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0">
                <!-- 뒤로 가기, 앞으로 가기 -->
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Click="BackButton_Click" Width="120" Height="40" Margin="4" ToolTip="이전">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text=" 뒤로 가기" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Click="ForwardButton_Click" Width="120" Height="40" Margin="4" ToolTip="다음">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="앞으로 가기 " FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 우측 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >

                <!-- 음성 지원 -->
                <Button Style="{StaticResource RoundedButtonStyle}"
                    x:Name="SpeakButton" Width="120" Height="40" Margin="4" ToolTip="소리로 듣기" Click="SpeakButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="SpeakButtonImage" Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/1538/1538548.png" />
                        <TextBlock x:Name="SpeakButtonText" Text="소리로 듣기" Margin="4 0 0 0" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <!-- 설정 -->
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="80" Height="40" Margin="50 0 0 0" ToolTip="설정" Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/709/709707.png" />
                        <TextBlock Text="설정" Margin="4 0 0 0" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        
        <wfi:WindowsFormsHost Grid.Row="1" Grid.Column="0" x:Name="browserHost" Margin="0,8" />
  
        
        <!-- AI 사이드바 -->
        <Border Grid.Row="1" Grid.Column="1" x:Name="aiSidebar" Background="#FFFDEFD0" BorderBrush="Gray" BorderThickness="1" Margin="10, 0, 10, 0">
            <Grid x:Name="AiSidebarGrid">
                <!-- 메인 메뉴 -->
                <StackPanel x:Name="AiMainMenuPanel" Margin="10">
                    <TextBlock Text="🤖 AI 활용하기" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Margin="0, 30, 0, 80">
                        <Button Content="이 페이지 뭐 하는 곳이야?" Click="WhatIsThisPageButton_Click" Height="40" Margin="20" FontSize="14"/>
                        <Button Content="본문 내용 요약해서 보기" Click="SummarizePageButton_Click" Height="40" Margin="20" FontSize="14"/>
                        <Button Content="단어 뜻 알려줘" Click="ExplainWordButton_Click" Height="40" Margin="20" FontSize="14"/>
                        <Button Content="AI가 대신 찾아줘요" Click="ShowAiSearchPanel_Click" Height="40" Margin="20" FontSize="14"/>
                        <Button Content="관련 키워드 추천받기" Click="RecommendKeywordsButton_Click" Height="40" Margin="20" FontSize="14"/>
                        
                        <!-- AI 제안 팝업 -->
                        <StackPanel x:Name="AiSmartSuggestionPanel" Visibility="Collapsed" Margin="10">
                            <TextBlock x:Name="AiSmartSuggestionText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="자세히 알려줘요" Click="ExplainSuggestion_Click" Margin="0,0,10,0"/>
                                <Button Content="닫기" Click="CloseSuggestion_Click"/>
                            </StackPanel>
                            <TextBox x:Name="AiSuggestionExplanationTextBox" TextWrapping="Wrap" FontSize="14" Background="#FFFDEFD0" IsReadOnly="True" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>


                <!--이 페이지 뭐하는 곳이야? UI-->
                <Grid x:Name="WhatIsThisPagePanel" Visibility="Collapsed" Margin="10" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                        <!-- 뒤로가기 버튼 -->
                        <RowDefinition Height="*" />
                        <!-- 스크롤 영역 -->
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="← 뒤로가기" Click="BackToAiMenu_Click1" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <ProgressBar x:Name="WhatIsThisLoadingBar"
                 Grid.Row="1"
                 Height="10"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="Collapsed" />


                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBox x:Name="WhatIsThisPageResultTextBox" IsReadOnly="True" Text="" TextWrapping="Wrap" FontSize="14" Background="#FFFDEFD0"/>
                    </ScrollViewer>
                </Grid>
                
                
                <!-- 본문 내용 요약해서 보기 UI -->
                <Grid x:Name="SummarizePagePanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="← 뒤로가기" Click="BackToAiMenu_Click5" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <ProgressBar x:Name="SummarizeLoadingBar"
                 Grid.Row="1"
                 Height="10"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="Collapsed" />



                    <TextBox x:Name="SummarizedTextBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontSize="14" Background="#FFFDEFD0"/>
                </Grid>



                <!-- 단어 뜻 알려줘 UI -->
                <Grid x:Name="ExplainWordPanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="← 뒤로가기" Click="BackToAiMenu_Click6" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <!-- ✅ 로딩바 위치 -->
                    <ProgressBar x:Name="ExplainWordLoadingBar"
                 Grid.Row="1"
                 Height="10"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="Collapsed" />


                    <TextBox x:Name="WordExplanationTextBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontSize="14" Background="#FFFDEFD0"/>
                </Grid>



                <!-- AI 검색 UI -->
                <StackPanel x:Name="AiSearchPanel" Visibility="Collapsed" Margin="10">
                    <Button Content="← 뒤로가기" Click="BackToAiMenu_Click2" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <TextBlock Text="궁금한 걸 검색해보세요" FontWeight="Bold" FontSize="14"/>
                    <TextBox x:Name="AiUserQueryTextBox" Height="30" FontSize="14" Margin="0,5" Foreground="Gray" Text="13살 손녀가 좋아할 선물 추천해줘" GotFocus="AiUserQueryTextBox_GotFocus" LostFocus="AiUserQueryTextBox_LostFocus"/>
                    <Button Content="AI가 답해줘요" Click="AiHelpSearchButton_Click" Height="35" Margin="0,10,0,0"/>
                </StackPanel>

                <Grid x:Name="AiSearchResultPanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="← 뒤로가기" Click="BackToAiMenu_Click2" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <ProgressBar x:Name="AiSearchLoadingBar"
                 Grid.Row="1"
                 Height="10"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="Collapsed" />

                    <TextBox x:Name="AiSearchResultTextBox"
             Grid.Row="2"
             TextWrapping="Wrap"
             FontSize="14"
             Background="#FFFDEFD0"
             IsReadOnly="True"
             AcceptsReturn="True"/>
                </Grid>




                <!-- AI 관련 키워드 추천 받기-->
                <Grid x:Name="AiKeywordPagePanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="← 뒤로가기" Grid.Row="0" Click="BackToAiMenu_Click3" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <ProgressBar x:Name="AiKeywordLoadingBar"
                 Grid.Row="1"
                 Height="10"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="Collapsed" />

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="🧠 관련 키워드를 추천해드릴게요!" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="AiKeywordPanel" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <!-- 전체 설명 패널 -->
                <Grid x:Name="AiExplanationPanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 뒤로가기 버튼 -->
                    <Button Grid.Row="0" Content="← 뒤로가기" Click="BackToAiMenu_Click4" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <ProgressBar x:Name="AiExplanationLoadingBar"
                 Grid.Row="1"
                 Height="10"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="Collapsed" />

                    <!-- 제목 -->
                    <TextBlock x:Name="AiExplanationTitle" Grid.Row="2" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- 주요 설명 -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="AiExplanationContent"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontSize="14"
                                 Background="#FFFDEFD0"
                                 Padding="10" />
                    </ScrollViewer>

                    <Button Grid.Row="4"
            Content="잘 모르겠어요"
            Click="MoreExplanation_Click"
            Height="40"
                            Width="150"
            Margin="0,10,0,0"
            FontSize="14"
            HorizontalAlignment="Center"/>

                </Grid>
            </Grid>
        </Border>




        <!-- 하단 도구 바 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10 0 10 0">

            <!-- 고대비 테마 -->
            <Button Style="{StaticResource RoundedButtonStyle}"
                Width="200" Height="40" Margin="4" ToolTip="고대비" Click="HighContrast_Click">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/3659/3659752.png" />
                    <TextBlock Text=" 고대비 화면으로 보기" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 사진 필터 토글 -->
            <Button x:Name="MediaFilterToggleButton"
                    Style="{StaticResource RoundedButtonStyle}"
                    Width="160" Height="40" Margin="4"
                    ToolTip="사진 및 영상은 원본 보기"
                    Click="MediaFilterToggle_Click"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/25/25301.png"/>
                    <TextBlock x:Name="MediaFilterButtonText" Text="사진 및 원본 보기" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>


            <!-- 글자 크기 조절 -->
            <StackPanel Orientation="Horizontal" Margin="40 0" VerticalAlignment="Center">
                <!-- 폰트 변경 -->
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="100" Height="40" Margin="4" ToolTip="폰트 변경" Click="ChangeFont_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="20" Height="20" Source="https://cdn-icons-png.flaticon.com/512/1828/1828919.png"/>
                        <TextBlock Text="폰트 변경" Margin="4, 0, 0, 0" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button
                        Style="{StaticResource RoundedButtonStyle}"
                        Width="100" Height="40" Margin="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Width="25" Height="25" Source="https://user-images.githubusercontent.com/537522/34322316-14a5c1a6-e839-11e7-8bdd-ecc63e88cdd5.png" />
                            <TextBlock Text=" 글자 크기 " FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="24" Height="24" Margin="2" Content="▲" FontSize="14" ToolTip="글자 크기 증가" Click="IncreaseFontSize_Click"/>
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="24" Height="24" Margin="2" Content="▼" FontSize="14" ToolTip="글자 크기 감소" Click="DecreaseFontSize_Click"/>
            </StackPanel>

            <!-- 확대, 축소 -->
            <StackPanel Orientation="Horizontal" Margin="10 0" VerticalAlignment="Center">
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="90" Height="40" Margin="5 4" ToolTip="확대" Click="ZoomIn_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="25" Height="25" Source="https://cdn-icons-png.flaticon.com/512/159/159084.png" />
                        <TextBlock Text=" 확대" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource RoundedButtonStyle}"
                    Width="90" Height="40" Margin="4" ToolTip="축소" Click="ZoomOut_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="25" Height="25" Source="https://cdn-icons-png.flaticon.com/512/159/159096.png" />
                        <TextBlock Text=" 축소" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 튜토리얼-->
            <Button Style="{StaticResource RoundedButtonStyle}"
                Width="100" Height="40" Margin="100 0 0 0" ToolTip="도움말">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="25" Height="25" Source="https://images.icon-icons.com/3377/PNG/512/help_icon_212398.png" />
                    <TextBlock Text=" 도움말" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>