<Window x:Class="WebSurfingHelpersForSenior.TutorialStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebSurfingHelpersForSenior"
        mc:Ignorable="d"
        Title="TutorialStepsWindow"  Height="800" Width="1400">
    <Grid>
        <!-- 제목 -->
        <TextBlock x:Name="StepTitle" Text="1) 홈 화면으로 바로가기" 
                   FontSize="24" FontWeight="Bold" Margin="20" />

        <StackPanel>
            <!-- 설명 -->
            <TextBlock x:Name="StepDescription" Text="왼쪽 위에 있는 🏠 홈 버튼을 누르면 언제든지 처음 화면으로 돌아갈 수 있어요.&#x0a;원래 보던 화면이 헷갈리면 이 버튼으로 다시 시작해보세요."
               Margin="50,70,20,0" TextWrapping="Wrap" FontSize="20"/>

            <!-- 이미지 강조 예시 -->
            <Image x:Name="StepImage" Source="/Assets/home.png" 
           HorizontalAlignment="Center" Margin="0,20,0,0" Width="986" Height="562"/>
        </StackPanel>



        <!-- 이전/다음 버튼 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button x:Name="PrevButton" Content="이전" Width="100" Margin="10" Click="PrevButton_Click" FontSize="16"/>
            <Button x:Name="NextButton" Content="다음" Width="100" Margin="10" Click="NextButton_Click" FontSize="16"/>
        </StackPanel>

        <!-- 체크박스와 시작 버튼 -->
        <CheckBox x:Name="DontShowAgainCheck" Content="다음부터 보지 않기" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,10"/>
        <Button Content="바로 시작하기" Width="120"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                Click="StartButton_Click" FontSize="14"/>
    </Grid>
</Window>

