<Window x:Class="WebSurfingHelpersForSenior.SetHomePageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebSurfingHelpersForSenior"
        mc:Ignorable="d"
        Title="홈 주소 설정" Height="250" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="홈 버튼 클릭 시 이동할 주소를 입력하세요:" Margin="0 0 0 10" FontWeight="Bold"/>
            <TextBox x:Name="UrlTextBox" Width="320" Height="30" Text="https://www.naver.com"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
                <Button Content="네이버" Width="80" Margin="5" Click="Naver_Click"/>
                <Button Content="구글" Width="80" Margin="5" Click="Google_Click"/>
                <Button Content="다음" Width="80" Margin="5" Click="Daum_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10">
                <Button Content="확인" Width="80" Margin="5" Click="Confirm_Click"/>
                <Button Content="취소" Width="80" Margin="5" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
