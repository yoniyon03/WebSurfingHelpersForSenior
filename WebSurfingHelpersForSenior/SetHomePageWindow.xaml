<Window x:Class="WebSurfingHelpersForSenior.SetHomePageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="홈 주소 설정"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" >
            <TextBlock Text="🏠 홈 버튼 클릭 시 이동할 주소를 입력하세요"
                       FontSize="22" FontWeight="Bold"
                       TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBox x:Name="UrlTextBox" Width="450" Height="40" FontSize="16" Margin="0,0,0,20"
                     Text="https://www.naver.com"/>

            <TextBlock Text="추천 사이트 선택" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="네이버" Width="120" Height="40" FontSize="16" Margin="10" Click="Naver_Click"/>
                <Button Content="구글" Width="120" Height="40" FontSize="16" Margin="10" Click="Google_Click"/>
                <Button Content="다음" Width="120" Height="40" FontSize="16" Margin="10" Click="Daum_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="확인" Width="120" Height="45" FontSize="16" Margin="10" Click="Confirm_Click"/>
                <Button Content="취소" Width="120" Height="45" FontSize="16" Margin="10" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>